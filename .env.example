# Database (SQLite for development, MySQL for production)
# Leave unset to use default: sqlite:///<project_root>/data/paperader.db
# PAPERADER_DATABASE_URL=sqlite:///absolute/path/to/paperader.db
# PAPERADER_DATABASE_URL=mysql+pymysql://user:pass@host:3306/paperader

# LLM Configuration
PAPERADER_LLM_MODEL=openrouter/google/gemini-2.5-flash
PAPERADER_LLM_API_KEY=your-api-key-here
PAPERADER_LLM_BASE_URL=https://openrouter.ai/api/v1

# Semantic Scholar (optional, higher rate limit with key)
PAPERADER_S2_API_KEY=

# Server
PAPERADER_SERVER_HOST=0.0.0.0
PAPERADER_SERVER_PORT=8000
PAPERADER_DEBUG=false
